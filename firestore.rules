rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: users
    // Fields: uid, name, email, phone, role, createdAt
    //
    // Collection: menu
    // Fields: id, name, description, price, categoryId, image, isAvailable, isPopular
    //
    // Collection: categories
    // Fields: id, name, order
    //
    // Collection: tables
    // Fields: id, number, zone, status
    //
    // Collection: orders
    // Fields: id, tableId, userId, items, total, status, paymentStatus, createdAt
    //
    // Collection: settings
    // Fields: isOpen, whatsappConnected
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "help@mitrainfotech.com" && request.auth.token.email_verified == true));
    }

    function isManager() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager' || isAdmin());
    }

    // Users
    match /users/{userId} {
      allow read: if isOwner(userId) || isManager();
      allow create: if isAuthenticated() && request.resource.data.role == 'user';
      allow update: if isOwner(userId) && request.resource.data.role == resource.data.role;
      allow write: if isAdmin();
    }

    // Menu & Categories
    match /menu/{itemId} {
      allow read: if true;
      allow write: if isManager();
    }
    match /categories/{catId} {
      allow read: if true;
      allow write: if isManager();
    }

    // Tables
    match /tables/{tableId} {
      allow read: if true;
      allow write: if isManager();
    }

    // Orders
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isManager());
      allow create: if true; // Allow guest orders for now, or require auth if needed
      allow update: if isManager() || (isAuthenticated() && request.auth.uid == resource.data.userId && request.resource.data.status == resource.data.status);
    }

    // Settings
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
